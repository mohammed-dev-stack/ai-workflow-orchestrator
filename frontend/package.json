{
    "name": "whatsapp-ai-agent-frontend",
    "version": "1.0.0",
    "description": "🤖 واجهة مستخدم منصة مساعد المعرفة بالذكاء الاصطناعي وأتمتة WhatsApp",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build:analyze": "ANALYZE=true vite build",
        "preview": "vite preview",
        "serve": "vite preview",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint . --ext ts,tsx --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "clean": "rm -rf dist node_modules/.vite",
        "prepare": "husky install"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.60.0",
        "@tanstack/react-query-devtools": "^5.60.0",
        "axios": "1.7.9",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.28.0",
        "tailwind-merge": "^2.5.4",
        "zustand": "^5.0.0"
    },
    "devDependencies": {
        "@babel/plugin-transform-runtime": "^7.25.9",
        "@eslint/js": "^9.15.0",
        "@tailwindcss/forms": "^0.5.9",
        "@tailwindcss/typography": "^0.5.15",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.5.2",
        "@types/node": "^22.9.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@typescript-eslint/eslint-plugin": "^8.15.0",
        "@typescript-eslint/parser": "^8.15.0",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/coverage-v8": "^2.1.5",
        "autoprefixer": "^10.5.4",
        "cssnano": "^8.0.2",
        "eslint": "^9.15.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "husky": "^9.1.6",
        "jsdom": "^25.0.1",
        "postcss": "^8.5.20",
        "prettier": "^3.3.3",
        "rollup-plugin-visualizer": "^5.12.0",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.6.3",
        "vite": "^5.4.11",
        "vitest": "^2.1.9"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "packageManager": "npm@10.9.0",
    "private": true,
    "author": {
        "name": "AI Knowledge Orchestrator",
        "email": "dev@whatsapp-ai.local"
    },
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "https://github.com/your-org/ai-knowledge-orchestrator.git"
    }
}
