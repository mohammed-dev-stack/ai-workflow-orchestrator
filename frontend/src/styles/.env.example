# ============================================================
# frontend/.env.example
# ملف قالب لمتغيرات البيئة — يوضح جميع المتغيرات المطلوبة
# انسخ هذا الملف إلى .env وقم بتعديل القيم حسب البيئة
# ============================================================

# ============================================================
# خادم التطوير (Development Server)
# ============================================================

# منفذ خادم التطوير (افتراضي: 5173)
VITE_PORT=5173

# ============================================================
# واجهة برمجة التطبيقات (API)
# ============================================================

# رابط الخادم الخلفي (Backend API)
# مثال للإنتاج: https://api.whatsapp-ai.local
VITE_API_URL=http://localhost:3000

# رابط WebSocket للاتصال في الوقت الفعلي
VITE_WS_URL=ws://localhost:3000/ws

# ============================================================
# إعدادات المصادقة (Authentication)
# ============================================================

# رابط إعادة التوجيه بعد تسجيل الدخول (في حالة استخدام OAuth)
# VITE_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# ============================================================
# إعدادات أخرى
# ============================================================

# مفتاح Google Analytics (اختياري)
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# بيئة التشغيل (development, production)
# VITE_ENV=development

# ============================================================
# ملاحظات هامة
# ============================================================
# 1. جميع المتغيرات التي تبدأ بـ VITE_ متاحة في الكود عبر import.meta.env
# 2. لا تضع أسراراً حساسة (مفاتيح API) في هذا الملف
# 3. يتم تجاهل ملف .env بواسطة Git (مُضاف في .gitignore)
# 4. لإضافة متغير جديد، قم بإضافته هنا وفي vite.config.ts
# 5. أعد تشغيل الخادم بعد تغيير أي متغير