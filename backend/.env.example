# ============================================================
# .env.example — نموذج لمتغيرات البيئة
# ============================================================
# تم توليد هذا الملف تلقائياً من env.schema.ts
# يرجى نسخه إلى .env وتعديل القيم حسب البيئة
# ============================================================

# 1. البيئة العامة

NODE_ENV=development  # النوع: "development" | "test" | "production" | اختياري | القيمة الافتراضية: development
PORT=3000  # النوع: number | اختياري | القيمة الافتراضية: 3000
CORS_ORIGIN=*  # النوع: unknown | unknown | اختياري | القيمة الافتراضية: *

# 2. قاعدة البيانات (PostgreSQL + pgvector)

DATABASE_URL=<unknown>  # النوع: unknown
DATABASE_POOL_TIMEOUT=10000  # النوع: number | اختياري | القيمة الافتراضية: 10000

# 3. Redis (BullMQ)

REDIS_URL=<unknown>  # النوع: unknown
REDIS_RETRY_DELAY=1000  # النوع: number | اختياري | القيمة الافتراضية: 1000

# 4. JWT (المصادقة)

JWT_SECRET=<unknown>  # النوع: unknown
JWT_EXPIRY=7d  # النوع: string | اختياري | القيمة الافتراضية: 7d

# 5. Anthropic Claude (الذكاء الاصطناعي)

ANTHROPIC_API_KEY=<unknown>  # النوع: unknown
ANTHROPIC_MODEL=claude-3-sonnet-20241022  # النوع: string | اختياري | القيمة الافتراضية: claude-3-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096  # النوع: number | اختياري | القيمة الافتراضية: 4096
ANTHROPIC_TEMPERATURE=0.3  # النوع: number | اختياري | القيمة الافتراضية: 0.3
ANTHROPIC_FALLBACK_MODEL=claude-3-haiku-20240307  # النوع: string | اختياري | القيمة الافتراضية: claude-3-haiku-20240307

# 6. قاطع الدائرة وإعادة المحاولة

CIRCUIT_BREAKER_TIMEOUT=30000  # النوع: number | اختياري | القيمة الافتراضية: 30000
CIRCUIT_BREAKER_ERROR_THRESHOLD=5  # النوع: number | اختياري | القيمة الافتراضية: 5
RETRY_MAX_ATTEMPTS=3  # النوع: number | اختياري | القيمة الافتراضية: 3
RETRY_BACKOFF_BASE=1000  # النوع: number | اختياري | القيمة الافتراضية: 1000

# 7. WhatsApp Cloud API

WHATSAPP_API_TOKEN=<unknown>  # النوع: unknown
WHATSAPP_VERIFY_TOKEN=<unknown>  # النوع: unknown
WHATSAPP_API_VERSION=v18.0  # النوع: string | اختياري | القيمة الافتراضية: v18.0
WHATSAPP_PHONE_NUMBER_ID=  # النوع: string | اختياري

# 8. قابلية المراقبة (Observability)

OTEL_EXPORTER_OTLP_ENDPOINT=  # النوع: string | اختياري
LOG_LEVEL=info  # النوع: "fatal" | "error" | "warn" | "info" | "debug" | "trace" | اختياري | القيمة الافتراضية: info

# 9. التكافؤ (Idempotency)

IDEMPOTENCY_TTL=86400  # النوع: number | اختياري | القيمة الافتراضية: 86400

# 10. حدود المعدل (Rate Limiting)

RATE_LIMIT_WINDOW_MS=60000  # النوع: number | اختياري | القيمة الافتراضية: 60000
RATE_LIMIT_MAX_REQUESTS=100  # النوع: number | اختياري | القيمة الافتراضية: 100

# 11. التشفير (Encryption)

ENCRYPTION_KEY=  # النوع: string | اختياري

# ============================================================
# نهاية ملف .env.example
# ============================================================